# Ces regles voyagent avec le dossier publie : elles s'appliquent aussi bien a un
# deploiement depuis le depot qu'a un depot manuel du seul dossier aos-ain-chock.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Les polices sont figees et decoupees pour cette page : elles ne changent jamais.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Les images et la feuille arabe changent avec le contenu : une semaine.
/assets/*.jpg
  Cache-Control: public, max-age=604800
/assets/*.css
  Cache-Control: public, max-age=604800
